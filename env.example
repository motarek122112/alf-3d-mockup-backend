ALF_MOCKUP_ENV=production
ALF_MOCKUP_SIGNING_KEY=REPLACE_WITH_PRIVATE_RANDOM_SECRET_AT_LEAST_32_CHARS
ALF_MOCKUP_DATA=/tmp/alf-mockup-data
ALF_ALLOWED_ORIGINS=https://alf-uniforms-kw.myshopify.com,https://www.alfuniforms.com
ALF_LOGO_MAX_BYTES=10485760
ALF_ALLOW_PROVISIONAL_MODELS=false
# Only used when real assets, a licensed Blender worker and persistent storage exist
ALF_APPROVED_ASSET_DIR=assets/approved
ALF_BLENDER_BIN=blender
ALF_CYCLES_SAMPLES=80
ALF_RENDER_RESOLUTION=1600
ALF_BLENDER_THREADS=2
